{
  "name": "@glastor/core",
  "version": "0.1.0",
  "description": "The resilient, high-throughput core engine powering next-generation distributed systems.",
  "license": "Apache-2.0",
  "exports": "./src/mod.ts",
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "docs": "deno run -A scripts/generate_docs.ts",
    "docs:check": "deno run -A scripts/generate_docs.ts --check",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": [
      "README.generated.md"
    ]
  },
  "lint": {
    "exclude": [
      "README.generated.md"
    ]
  }
}
